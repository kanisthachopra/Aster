# Copy to .env.local. Keep the key on this computer; do not use a VITE_ prefix.
DEEPGRAM_API_KEY=
# Supported: aura-2-thalia-en, aura-2-apollo-en, aura-2-orpheus-en,
# aura-2-luna-en, aura-2-asteria-en.
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Maximum characters sent in a rolling 24-hour window while the local server runs,
# including failed attempts. Restarting clears this in-memory guardrail.
# Cached replays do not consume this local budget. Range: 1800–200000.
DEEPGRAM_SESSION_CHAR_BUDGET=20000
